{
  "name": "remotion-event-video-generator",
  "version": "1.0.0",
  "private": true,
  "description": "Generator video bumper 9:16 60 FPS dengan TTS dinamis untuk dokumentasi event himpunan",
  "scripts": {
    "start": "remotion preview",
    "preview": "remotion preview",
    "tts": "node scripts/generate-tts.js",
    "build": "remotion bundle",
    "render:intro": "remotion render Intro out/intro-9x16-60fps.mp4",
    "render:lowerthird": "remotion render LowerThird out/lowerthird-9x16-60fps.mp4",
    "render:outro": "remotion render OutroCredits out/outro-9x16-60fps.mp4",
    "render:all": "npm run render:intro && npm run render:lowerthird && npm run render:outro"
  },
  "dependencies": {
    "@remotion/google-fonts": "^4.0.536",
    "google-tts-api": "^2.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.536",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.536",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "typescript": "^5.7.3"
  }
}
